{
  "schemaVersion": "1.0.0",
  "selectionPolicy": "priority-then-capability",
  "fallbackPolicy": "exact-or-approved-equivalent",
  "providers": [
    {
      "id": "github-hosted-default",
      "type": "github-hosted",
      "enabled": true,
      "priority": 10,
      "capabilities": ["governance", "lightweight", "dotnet-baseline", "integration"],
      "evidenceLevel": "native-check",
      "availability": "runtime",
      "secretRefs": []
    },
    {
      "id": "github-self-hosted-default",
      "type": "github-self-hosted",
      "enabled": true,
      "priority": 20,
      "capabilities": ["governance", "dotnet-baseline", "dotnet", "integration", "render"],
      "evidenceLevel": "native-check",
      "availability": "runtime",
      "runnerLabels": ["self-hosted", "windows"],
      "secretRefs": []
    },
    {
      "id": "circleci-default",
      "type": "circleci",
      "enabled": false,
      "priority": 30,
      "capabilities": ["governance", "dotnet-baseline", "dotnet", "integration"],
      "evidenceLevel": "provider-artifact",
      "availability": "runtime",
      "secretRefs": ["CIRCLECI_TOKEN"]
    },
    {
      "id": "local-evidence-default",
      "type": "local-evidence",
      "enabled": true,
      "priority": 40,
      "capabilities": ["governance", "dotnet-baseline", "dotnet", "integration"],
      "evidenceLevel": "hashed-local-artifact",
      "availability": "runtime",
      "secretRefs": []
    }
  ],
