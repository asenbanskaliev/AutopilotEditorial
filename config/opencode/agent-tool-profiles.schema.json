{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookstudio.local/schemas/agent-tool-profiles.schema.json",
  "title": "BookStudio Agent Tool Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "profiles"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "identifierList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "version",
        "workflow",
        "role",
        "allowedCapabilities",
        "allowedTools",
        "forbiddenCapabilities",
        "forbiddenTools",
        "requiresHumanApproval",
        "maximumToolCalls",
        "maximumParallelTools"
      ],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "workflow": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/identifier" },
        "allowedCapabilities": { "$ref": "#/$defs/identifierList" },
        "allowedTools": { "$ref": "#/$defs/identifierList" },
        "forbiddenCapabilities": { "$ref": "#/$defs/identifierList" },
        "forbiddenTools": { "$ref": "#/$defs/identifierList" },
        "requiresHumanApproval": { "type": "boolean" },
        "maximumToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maximumParallelTools": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    }
  }
}
